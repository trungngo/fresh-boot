// Zed settings
//
// Docs: https://zed.dev/docs/configuring-zed
// Run `zed: open default settings` from the command palette to see every
// available option with its default value.
{
  // Open files from the `zed` CLI in a new window rather than reusing one.
  "cli_default_open_behavior": "new_window",

  // Opt out of everything phoning home.
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },

  "session": {
    "trust_all_worktrees": true
  },

  // Vim mode. This also enables Zed's stock vim keymap, which already
  // provides the ctrl-w window commands; see keymap.json for the
  // <Leader> bindings ported from bundles/vim/ideavimrc.
  "vim_mode": true,

  "icon_theme": "Zed (Default)",
  "base_keymap": "VSCode",

  "ui_font_size": 16,
  "buffer_font_size": 22,

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
}
