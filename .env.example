# Every key this repository needs, with no values. This repository holds no secrets.
#
#   KEY=   a dot.yml prompt (asked once, kept in ~/.config/dot/local.env), or set it in
#          ~/.config/dot/local.env / .env.local yourself (this machine only). Personal values
#          never go in the committed .env.
# docs/private-overlay.md lists everything that lives outside this repository.

MY_NAME=
MY_EMAIL=
MY_MACHINE=
